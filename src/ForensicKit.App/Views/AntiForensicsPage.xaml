<Page x:Class="ForensicKit.App.Views.AntiForensicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ForensicKit.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:AntiForensicsViewModel}"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Timeline anti-forense">

    <Grid Margin="28,8,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Timeline anti-forense" Style="{StaticResource Impero.H1}" />
            <TextBlock Text="Indicatori di attivita' anti-forense e tracce di sistema, ordinati come linea temporale."
                       Style="{StaticResource Impero.Subtitle}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="▶  Esegui analisi" Style="{StaticResource Impero.PrimaryButton}"
                        Command="{Binding RunCommand}" />
                <CheckBox Content="Elevazione (UAC)" IsChecked="{Binding RunElevated}"
                          Foreground="{StaticResource Impero.TextSecondary}"
                          VerticalAlignment="Center" Margin="14,0,0,0" />

                <TextBlock Text="Severita':" VerticalAlignment="Center" Margin="20,0,8,0"
                           Foreground="{StaticResource Impero.TextSecondary}" />
                <ComboBox Width="120" VerticalAlignment="Center"
                          ItemsSource="{Binding SeverityFilters}"
                          SelectedItem="{Binding SelectedSeverity}" />

                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="16,0,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border CornerRadius="20" Padding="10,4" Margin="6,0" Background="#2AFF2E88">
                    <TextBlock Foreground="#FF2E88" FontSize="12" FontWeight="SemiBold"
                               Text="{Binding HighCount, StringFormat='Alto: {0}'}" />
                </Border>
                <Border CornerRadius="20" Padding="10,4" Margin="6,0" Background="#2AFF8C00">
                    <TextBlock Foreground="#FF8C00" FontSize="12" FontWeight="SemiBold"
                               Text="{Binding SuspectCount, StringFormat='Sospetto: {0}'}" />
                </Border>
                <Border CornerRadius="20" Padding="10,4" Margin="6,0" Background="#2A00D4FF">
                    <TextBlock Foreground="#00D4FF" FontSize="12" FontWeight="SemiBold"
                               Text="{Binding InfoCount, StringFormat='Info: {0}'}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Timeline table -->
        <Border Grid.Row="2" Style="{StaticResource Impero.Panel}" Padding="2">
            <DataGrid ItemsSource="{Binding Events}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="#0FFFFFFF"
                      Foreground="{StaticResource Impero.TextPrimary}"
                      BorderThickness="0" HorizontalGridLinesBrush="{StaticResource Impero.Border}"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>

                    <!-- Timeline dot -->
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SeverityToForeground}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Quando" Binding="{Binding TimeText}" Width="150" />

                    <!-- Severity pill -->
                    <DataGridTemplateColumn Header="Severita'" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="20" Padding="9,3" HorizontalAlignment="Left"
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToForeground}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="Sorgente" Binding="{Binding Source}" Width="190" />

                    <!-- Detail (wrapping) -->
                    <DataGridTemplateColumn Header="Dettaglio" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           Margin="2,4" Foreground="{StaticResource Impero.TextSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status overlay text -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                   Foreground="{StaticResource Impero.TextSecondary}"
                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
