<Page x:Class="ForensicKit.App.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ForensicKit.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Log">

    <Grid Margin="28,8,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Log delle esecuzioni" Style="{StaticResource Impero.H1}" />
            <TextBlock Text="Registro immutabile (append-only) di download ed esecuzioni — utile per la catena di custodia."
                       Style="{StaticResource Impero.Subtitle}" Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Aggiorna" Style="{StaticResource Impero.SecondaryButton}"
                    Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
            <Button Content="Apri file di log" Style="{StaticResource Impero.GhostButton}"
                    Command="{Binding OpenLogFileCommand}" />
            <Border CornerRadius="20" Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Center"
                    Background="{StaticResource Impero.SoftAccent}">
                <TextBlock Text="{Binding Count, StringFormat='{}{0} voci'}"
                           Foreground="{StaticResource Impero.AccentLight}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Impero.Panel}" Padding="1">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="{StaticResource Impero.Card}"
                      Foreground="{StaticResource Impero.TextPrimary}"
                      BorderThickness="0" HorizontalGridLinesBrush="{StaticResource Impero.Border}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data (UTC)" Width="160"
                                        Binding="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                    <DataGridTextColumn Header="Categoria" Width="90" Binding="{Binding Category}" />
                    <DataGridTextColumn Header="Tool" Width="150" Binding="{Binding ToolName}" />
                    <DataGridTextColumn Header="Azione" Width="140" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Esito" Width="90" Binding="{Binding Result}" />
                    <DataGridTextColumn Header="Utente" Width="110" Binding="{Binding User}" />
                    <DataGridTextColumn Header="Dettagli" Width="*" Binding="{Binding Details}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
