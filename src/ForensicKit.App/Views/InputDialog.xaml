<Window x:Class="ForensicKit.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   Grid.Row="1"
                   Foreground="#E0E0E0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox x:Name="ResponseBox"
                 Grid.Row="2"
                 VerticalAlignment="Top"
                 Background="#2D2D30"
                 Foreground="#F0F0F0"
                 BorderBrush="#3F3F46"
                 Padding="6" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    Width="90"
                    IsDefault="True"
                    Click="Ok_Click"
                    Margin="0,0,8,0" />
            <Button Content="Annulla"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
