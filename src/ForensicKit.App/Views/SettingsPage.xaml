<Page x:Class="ForensicKit.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ForensicKit.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      mc:Ignorable="d"
      Background="Transparent"
      Title="Impostazioni">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,28,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Impostazioni" Style="{StaticResource Impero.H1}" Margin="0,0,0,20" />

            <!-- Download -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Download" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="Cartella di destinazione dei tool scaricati"
                               Style="{StaticResource Impero.Subtitle}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding DownloadRoot}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Sfoglia…" Margin="10,0,0,0"
                                Style="{StaticResource Impero.SecondaryButton}"
                                Command="{Binding BrowseDownloadFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Catalog -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Catalogo (manifest)" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox Content="Aggiorna automaticamente il catalogo all'avvio (manifest remoto)"
                              IsChecked="{Binding AutoUpdateCatalog}"
                              Foreground="{StaticResource Impero.TextSecondary}" Margin="0,0,0,10" />
                    <TextBlock Text="URL del manifest remoto (raw GitHub)" Style="{StaticResource Impero.Subtitle}" />
                    <ui:TextBox Text="{Binding ManifestUrl}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Network -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rete" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="Proxy HTTP(S) — lascia vuoto per usare le impostazioni di sistema"
                               Style="{StaticResource Impero.Subtitle}" />
                    <ui:TextBox Text="{Binding ProxyUrl}" PlaceholderText="http://proxy.azienda:8080" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Aspetto" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <ui:ToggleSwitch Content="Tema scuro" IsChecked="{Binding IsDarkTheme}" />
                    <TextBlock Text="Accent color (#RRGGBB, opzionale)" Style="{StaticResource Impero.Subtitle}"
                               Margin="0,12,0,0" />
                    <ui:TextBox Text="{Binding AccentColor}" PlaceholderText="#7B39ED" Width="180"
                                HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Security -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sicurezza" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox Content="Ricorda la conferma di fiducia dopo il primo avvio di ogni tool"
                              IsChecked="{Binding RememberTrust}"
                              Foreground="{StaticResource Impero.TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Data folder -->
            <Border Style="{StaticResource Impero.Panel}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dati applicazione" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource Impero.TextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding AppDataFolder}" Style="{StaticResource Impero.Subtitle}"
                               TextWrapping="Wrap" />
                    <Button Content="Apri cartella dati" Style="{StaticResource Impero.GhostButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding OpenAppDataFolderCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Salva impostazioni" Style="{StaticResource Impero.PrimaryButton}"
                        Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource Impero.Green}" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
